doctype html
html
  head
    title
      = content_for(:title) || "Payment System"
    meta name="viewport" content="width=device-width,initial-scale=1"
    meta name="apple-mobile-web-app-capable" content="yes"
    meta name="application-name" content="Payment System"
    meta name="mobile-web-app-capable" content="yes"
    = csrf_meta_tags
    = csp_meta_tag
    
    = yield :head
    
    / PWA manifest (commented out, enable in config/routes.rb if needed)
    / link rel="manifest" href=pwa_manifest_path(format: :json)
    
    link rel="icon" href="/icon.png" type="image/png"
    link rel="icon" href="/icon.svg" type="image/svg+xml"
    link rel="apple-touch-icon" href="/icon.png"
    
    / Bootstrap CSS
    link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-T3c6CoIi6uLrA9TneNEoa7RxnatzjcDSCmG1MXxSR1GAsXEV/Dwwykc2MPK8M2HN" crossorigin="anonymous"
    
    / Application stylesheets
    = stylesheet_link_tag :app, "data-turbo-track": "reload"
    = javascript_importmap_tags
    
  body
    / Navigation bar
    - if user_signed_in?
      nav.navbar.navbar-expand-lg.navbar-dark.bg-dark
        .container-fluid
          a.navbar-brand href="/"
            | Payment System
          .navbar-nav.me-auto
            = link_to "Transactions", transactions_path, class: "nav-link text-light"
            = link_to "Merchants", merchants_path, class: "nav-link text-light"
          .navbar-nav.ms-auto
            .navbar-text.text-light.me-3
              strong= current_user.name
              span.badge.bg-primary.ms-2= current_user.role.titleize
            = button_to "Logout", logout_path, method: :delete, class: "btn btn-outline-light btn-sm"
    
    / Flash messages
    - if flash.any?
      .container.mt-3
        - flash.each do |type, message|
          .alert class="alert-#{flash_class(type)}" role="alert"
            = message
    
    / Main content
    = yield
    
    / Bootstrap JS Bundle (includes Popper)
    script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js" integrity="sha384-C6RzsynM9kWDrMNeT87bh95OGNyZPhcTNXj1NW7RuBCsyN/o0jlpcV8Qyq46cDfL" crossorigin="anonymous"

