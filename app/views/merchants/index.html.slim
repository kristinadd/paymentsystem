.container.mt-5
  .row
    .col-12
      .d-flex.justify-content-between.align-items-center.mb-4
        div
          h1.display-4 Merchants
          - if current_user.admin?
            p.text-muted.mb-0 Viewing all merchants (Admin)
          - else
            p.text-muted.mb-0 Your merchant account
        span.badge.bg-primary.fs-5
          = pluralize(@merchants.count, 'merchant')
  
  .row
    .col-12
      .card.shadow
        .card-body
          .table-responsive
            table.table.table-hover.table-striped.align-middle
              thead.table-dark
                tr
                  th Name
                  th Email
                  th Description
                  th Status
                  th Total Transaction Sum
                  th Created At
                  th Actions
              tbody
                - if @merchants.any?
                  - @merchants.each do |merchant|
                    tr
                      td
                        strong= merchant.name
                      td
                        = merchant.email
                      td
                        - if merchant.description.present?
                          = merchant.description
                        - else
                          span.text-muted N/A
                      td
                        - if merchant.active?
                          span.badge.bg-success Active
                        - else
                          span.badge.bg-danger Inactive
                      td.text-end
                        strong= number_to_currency(merchant.total_transaction_sum || 0)
                      td
                        = merchant.created_at.strftime("%Y-%m-%d %H:%M")
                      td
                        .d-flex.gap-2
                          = link_to "Edit", edit_merchant_path(merchant), class: "btn btn-warning btn-sm"
                          = button_to "Delete", merchant_path(merchant), method: :delete, class: "btn btn-danger btn-sm", data: { confirm: "Are you sure you want to delete '#{merchant.name}'? This action cannot be undone." }
                - else
                  tr
                    td.text-center.text-muted colspan="7"
                      .py-5
                        i.bi.bi-inbox.fs-1
                        p.mt-3 No merchants found

